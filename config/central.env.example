# Settings for MULTI-SOURCE mode (scripts/central/*), on the central server.
# Single-database mode uses config/feeds.env instead and ignores this file.
#
# Copy to config/central.env on the central server and fill in real values:
#     cp config/central.env.example config/central.env
#     chmod 600 config/central.env
# central.env is in .gitignore and must never be committed. No passwords go in this file.

# ---- Clusters ------------------------------------------------------------
# One line per EPAS cluster: see config/sources.conf.example.
SOURCES_FILE="$REPO_DIR/config/sources.conf"

# Feed account used on every cluster (a line in sources.conf can override it).
# Passwords: one line per cluster in ~/.pgpass (chmod 600), e.g.
#     pgprd01.example.com:5444:sailpoint:sailpoint_feed:<password>
PGUSER="sailpoint_feed"

# Traffic crosses the network: require SSL (match with hostssl lines in pg_hba.conf).
PGSSLMODE="require"
PGCONNECT_TIMEOUT="15"                 # seconds to wait for a cluster to answer
STATEMENT_TIMEOUT_MS="600000"          # cancel a query after 10 minutes
PARALLEL="4"                           # clusters processed at the same time

# ---- Active Directory ----------------------------------------------------
LDAP_URI="ldaps://ad.example.com:636"
BIND_DN="CN=svc_pg_ldap_read,OU=Service Accounts,DC=example,DC=com"
BIND_PW_FILE="$HOME/.ad_bind_pw"       # password only, no newline, chmod 600

# Where to look up every login (usually the domain root).
AD_BASE="DC=example,DC=com"

# How AD identifies non-person (service) accounts. Use ONE approach:
#   (a) by OU: NPID_SEARCH_BASE = the service-account OU, keep the plain filter
#   (b) by attribute: NPID_SEARCH_BASE = domain root, filter on the attribute, e.g.
#       NPID_FILTER='(&(objectClass=user)(employeeType=Non-Personal))'
NPID_SEARCH_BASE="OU=Service Accounts,DC=example,DC=com"
NPID_FILTER='(&(objectClass=user)(!(objectClass=computer)))'

# AD attributes used to fill feed columns. Leave one empty ("") to leave its column blank.
AD_ATTR_FIRST_NAME="givenName"         # userFirstName
AD_ATTR_LAST_NAME="sn"                 # userLastName
AD_ATTR_OWNER="manager"                # primaryOwner (NPIDs only); a DN, its CN is used
AD_ATTR_COST_CENTRE="department"       # costCentre (NPIDs only)

AD_BATCH="200"                         # logins per LDAP query

# ---- Output ---------------------------------------------------------------
OUTPUT_DIR="/data/sailpoint/outbound"  # where SailPoint picks up the files
ACCESS_FILE_NAME="access_feed.csv"
ACCOUNT_FILE_NAME="account_feed.csv"

# Account file layout: "rows" = one row per account per role,
#                      "combined" = one row per account, roles joined by '|'
ACCOUNT_LAYOUT="rows"

# ---- Failure handling (tolerant) -------------------------------------------
# If a cluster (or AD) cannot be read, its last good extract is reused for up to
# MAX_STALE_HOURS. After that the run fails and the previously published files stay.
MAX_STALE_HOURS="48"

# Working data: last good extracts, run folders, archive of published files, status.
STATE_DIR="/var/lib/edb-sailpoint-feeds"
KEEP_DAYS="90"                         # keep run folders and archived files this long

# ---- Reporting --------------------------------------------------------------
# Always: log on stdout (redirect it in cron), exit code 0/1/2, and a status file.
STATUS_FILE="$STATE_DIR/status.json"
# Optional email (needs a working `mail` command on the server). Empty = no email.
MAIL_TO=""
MAIL_ON="problems"                     # "problems" (exit 1 or 2) or "always"

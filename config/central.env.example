# Settings for scripts/collect_all.sh on the central server.
#
# Copy to config/central.env and fill in real values:
#     cp config/central.env.example config/central.env
#     chmod 600 config/central.env
# central.env is in .gitignore and must never be committed. No passwords go in this file:
#   - cluster passwords: ~/.pgpass of the account running cron (one line per cluster)
#   - AD bind settings and passwords: read from each cluster's pg_hba.conf at run time

# ---- Clusters ------------------------------------------------------------
SOURCES_FILE="$REPO_DIR/config/sources.conf"   # one line per cluster
PGUSER="sailpoint_feed"                        # feed account (a sources.conf line can override)
PGDATABASE="postgres"                          # database to connect to (sources.conf can override)

PGSSLMODE="require"                            # the AD bind passwords travel over this connection
PGCONNECT_TIMEOUT="15"                         # seconds to wait for a cluster
STATEMENT_TIMEOUT_MS="600000"                  # cancel a query after 10 minutes
PARALLEL="4"                                   # clusters / AD lookups at the same time

# ---- Person / non-person (must match the OU names in pg_hba.conf exactly) ----
PERSON_OU="Person ID"                          # ldapbasedn with OU=Person ID     -> Personal ID
NONPERSON_OU="Non Person Id"                   # ldapbasedn with OU=Non Person Id -> Non-Personal ID

# ---- AD attributes for the optional columns ------------------------------------
# Leave one empty ("") to leave its column blank.
AD_ATTR_FIRST_NAME="givenName"                 # userFirstName
AD_ATTR_LAST_NAME="sn"                         # userLastName
AD_ATTR_OWNER="manager"                        # primaryOwner, non-person accounts only (DN -> its CN)
AD_ATTR_COST_CENTRE="department"               # costCentre, non-person accounts only
AD_BATCH="200"                                 # logins per LDAP query
# If the AD servers' TLS certificates are signed by an internal CA, point OpenLDAP at it:
# export LDAPTLS_CACERT="/etc/pki/tls/certs/corp-ca.pem"

# ---- Output -------------------------------------------------------------------
OUTPUT_DIR="/data/sailpoint/outbound"          # where SailPoint picks up the files
ACCESS_FILE_NAME="access_feed.csv"
ACCOUNT_FILE_NAME="account_feed.csv"

# ---- History and reporting ------------------------------------------------------
# Runs are independent: nothing here is ever read by a later run.
STATE_DIR="/var/lib/edb-sailpoint-feeds"       # run logs (runs/) and published copies (archive/)
KEEP_DAYS="90"                                 # delete run logs and archived files after this
STATUS_FILE="$STATE_DIR/status.json"           # result of the last run, for monitoring
MAIL_TO=""                                     # e.g. "dba-team@example.com"; empty = no email
MAIL_ON="problems"                             # "problems" (failed runs) or "always"

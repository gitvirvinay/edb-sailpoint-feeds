# Settings for the SailPoint feed scripts.
#
# Copy this file to config/feeds.env on the server and fill in real values:
#     cp config/feeds.env.example config/feeds.env
#     chmod 600 config/feeds.env
# feeds.env is listed in .gitignore and must never be committed.
# No passwords go in this file (see "Passwords" below).

# ---- Postgres / EPAS ----------------------------------------------------
# Needs a superuser or equivalent account: pg_hba_file_rules and dba_users are restricted.
# "localhost" when the scripts run on the DB server; must match the pg_hba.conf line (README).
PGHOST="localhost"
PGPORT="5444"
PGDATABASE="sailpoint"            # dedicated database; see README "Server setup"
PGUSER="sailpoint_feed"           # must match the name used in sql/setup (-v feed_user=...)

# ---- Active Directory (used by ad_npid_sync.sh) -------------------------
# Reuse the server and bind details from the ldap lines in pg_hba.conf where possible.
LDAP_URI="ldaps://ad.example.com:636"
BIND_DN="CN=svc_pg_ldap_read,OU=Service Accounts,DC=example,DC=com"
BIND_PW_FILE="$HOME/.ad_bind_pw"

# How AD identifies non-person (service) accounts. Use ONE approach:
#   (a) by OU: set SEARCH_BASE to the service-account OU and keep the plain FILTER below
#   (b) by attribute: set SEARCH_BASE to the domain root and filter on the attribute, e.g.
#       FILTER='(&(objectClass=user)(employeeType=Non-Personal))'
SEARCH_BASE="OU=Service Accounts,DC=example,DC=com"
FILTER='(&(objectClass=user)(!(objectClass=computer)))'

# Database logins checked per LDAP query
BATCH=200

# ---- Output (used by run_feeds.sh) --------------------------------------
# Folder where SailPoint picks up the CSV files
OUTPUT_DIR="/data/sailpoint/outbound"

# Which account feed layout SailPoint wants:
#   account_feed_option1_combined.sql  one row per account, roles joined by '|'
#   account_feed_option2_rows.sql      one row per account per role
ACCOUNT_FEED_SQL="account_feed_option2_rows.sql"

# ---- Passwords (NOT in this file) ----------------------------------------
# Postgres: ~/.pgpass of the user running cron (chmod 600), one line:
#     db-server.example.com:5444:sailpoint:sailpoint_feed:<password>
# AD bind:  the file named in BIND_PW_FILE (chmod 600), containing only the password
#           with no trailing newline:  printf '%s' '<password>' > ~/.ad_bind_pw
